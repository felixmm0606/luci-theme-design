{#
    Material is a clean HTML5 theme for LuCI. It is based on luci-theme-bootstrap and MUI

    luci-theme-material
        Copyright 2015 Lutty Yang <lutty@wcan.in>
            
    luci-theme-neobird
    Copyright 2021 2smile <thinktip@gmail.com>

    luci-theme-design
    Copyright 2023 gngpp <gngppz@gmail.com>

    Have a bug? Please create an issue here on GitHub!
        https://github.com/LuttyYang/luci-theme-material/issues

    luci-theme-bootstrap:
    Copyright 2008 Steven Barth <steven@midlink.org>
    Copyright 2008 Jo-Philipp Wich <jow@openwrt.org>
    Copyright 2012 David Menting <david@nut-bolt.nl>

    MUI:
    https://github.com/muicss/mui

    Licensed to the public under the Apache License 2.0
-#}

{%
	import { stat } from 'fs';

	const css_mtime = stat(`/www${media}/css/style.css`)?.mtime ?? 0;
	const js_mtime = stat(`/www${media}/js/apply.js`)?.mtime ?? 0;
	const script_mtime = stat(`/www${media}/js/script.js`)?.mtime ?? 0;
	const asset_version = (css_mtime > js_mtime
		? (css_mtime > script_mtime ? css_mtime : script_mtime)
		: (js_mtime > script_mtime ? js_mtime : script_mtime)) || version.luciversion;

	/* luci.dispatcher.node_visible() */
	const node_visible = (nd) => !!(nd?.satisfied !== false && nd?.title && length(nd.title) && nd.action &&
		nd.hidden != true && !(nd.action.type == 'firstchild' && !length(nd.children ?? {})));

	/* luci.dispatcher.node_childs(): order ascending, default 100 */
	const node_childs = (nd) => {
		const childs = [];

		if (!nd)
			return childs;

		const children = nd.children ?? {};

		for (let name, child in children)
			if (node_visible(child))
				push(childs, name);

		return sort(childs, (a, b) => ((children[a].order ?? 100) - (children[b].order ?? 100)) ||
			(a < b ? -1 : (a > b ? 1 : 0)));
	};

	/* dispatcher context - mirrors the Lua footer */
	const controller = dispatcher.build_url();
	const tree = dispatcher.menu_json();

	const request = ctx.path ?? [];
	const category = request[0];
	const categories = node_childs(tree);
-%}
                </div>
                <footer class="footer" style="text-align:center">
                    <a href="https://github.com/openwrt/luci">Powered by {{ version.luciname }}</a> |
                    <a href="https://www.lede-project.org/">{{ version.distversion }}</a>
                    <br />
                    © 2021-2022 2smile. All Rights Reserved.
                    {% if (length(categories) > 1): %}
                    <ul class="breadcrumb pull-right" id="modemenu">
                        {% for (let r in categories): %}
                        <li{% if (category == r): %} class="active"{% endif %}><a href="{{ controller }}/{{ r }}/">{{ striptags(_(tree.children[r].title)) }}</a> <span class="divider">|</span></li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </footer>
            </div>
        </div>

    <script>
            /* icon font glyphs U+E20A / U+E20B, emitted as raw UTF-8 bytes */
            $(".cbi-button-up").val("{{ chr(0xee, 0x88, 0x8a) }}");
            $(".cbi-button-down").val("{{ chr(0xee, 0x88, 0x8b) }}");
        	// fix legend position
			$("legend").each(function () {
        		var that = $(this);
        		that.after("<span class='panel-title'>" + that.text() + "</span>");
    		});
            // Fixed openclash plugin causing env(safe-area-inset-bottom) to be 0 under
            if (/(iPhone|iPad|iPod|iOS)/i.test(navigator.userAgent) && self.location.pathname.indexOf("openclash") != -1) {
                var oMeta = document.createElement('meta');
                oMeta.content = 'width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0,viewport-fit=cover';
                oMeta.name = 'viewport';
                document.querySelector('head').appendChild(oMeta);
            }
    </script>  
    <script src="{{ media }}/js/apply.js?v={{ asset_version }}"></script>
</body>
</html>
